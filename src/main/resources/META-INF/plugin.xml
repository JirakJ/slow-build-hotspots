<idea-plugin>
    <id>com.jakubjirak.buildhotspots</id>
    <product-descriptor code="PBUILDHOTSPOTS" release-date="20260215" release-version="20262" optional="true"/>
    <name>Slow Build Hotspots</name>
    <vendor email="jakub@jirak.dev" url="https://github.com/jakubjirak">Jakub Jirák</vendor>

    <description><![CDATA[
    <h2>Slow Build Hotspots</h2>
    <p>Parses Gradle build scan logs and <code>--profile</code> output to identify slow tasks,
    cache miss causes, and non-incremental builds. Shows a build performance dashboard with
    actionable optimization suggestions.</p>

    <h3>Features</h3>
    <ul>
        <li><b>Build profile parsing</b> — analyzes Gradle <code>--profile</code> HTML reports</li>
        <li><b>Hotspot detection</b> — identifies slow tasks, cache misses, non-incremental builds</li>
        <li><b>Performance dashboard</b> — task breakdown sorted by duration</li>
        <li><b>Optimization suggestions</b> — actionable tips to speed up your builds</li>
        <li><b>Build time trends</b> — track build performance over time (Pro)</li>
    </ul>

    <h3>Getting Started</h3>
    <ol>
        <li>Run your Gradle build with <code>./gradlew build --profile</code></li>
        <li>Open the <b>Build Hotspots</b> tool window</li>
        <li>Click <b>Analyze Build Profile</b> to see results</li>
    </ol>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="git-features.xml">Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool window -->
        <toolWindow
                id="Build Hotspots"
                anchor="bottom"
                secondary="true"
                icon="/icons/hotspot.svg"
                factoryClass="com.jakubjirak.buildhotspots.ui.BuildHotspotsToolWindowFactory"/>

        <!-- Settings page -->
        <applicationConfigurable
                id="com.jakubjirak.buildhotspots.settings"
                parentId="tools"
                displayName="Slow Build Hotspots"
                instance="com.jakubjirak.buildhotspots.settings.BuildHotspotsConfigurable"/>

        <!-- Persistent settings -->
        <applicationService
                serviceImplementation="com.jakubjirak.buildhotspots.settings.BuildHotspotsSettings"/>

        <!-- Application services -->
        <applicationService
                serviceImplementation="com.jakubjirak.buildhotspots.history.BuildHistoryStore"/>

        <applicationService
                serviceImplementation="com.jakubjirak.buildhotspots.licensing.FreemiumGate"/>

        <!-- Notification group -->
        <notificationGroup
                id="Build Hotspots"
                displayType="BALLOON"
                toolWindowId="Build Hotspots"/>
    </extensions>

    <actions>
        <action id="com.jakubjirak.buildhotspots.AnalyzeBuildAction"
                class="com.jakubjirak.buildhotspots.actions.AnalyzeBuildAction"
                text="Analyze Build Profile"
                description="Analyze the latest Gradle build profile for performance hotspots"
                icon="AllIcons.Actions.Profile">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
